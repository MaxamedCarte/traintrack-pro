# MongoDB connection string (MongoDB Atlas recommended for Vercel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/traintrack?retryWrites=true&w=majority

# Long random string used to sign admin sessions and QR check-in tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# First administrator account. Created automatically on first sign-in if no admins exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Public base URL used inside QR codes (optional; defaults to the request origin)
NEXT_PUBLIC_APP_URL=
